# --- Supabase ---
# Trouvables dans Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx...
# Clé service_role : NE JAMAIS exposer côté client. Utilisée uniquement dans
# les Route Handlers / Server Actions pour les opérations admin (export CSV,
# écriture protégée par RLS).
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx...

# --- Resend (emails transactionnels) ---
# Clé API : https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx
# Adresse d'expédition, doit être sur un domaine vérifié dans Resend
EMAIL_FROM="Agorabica <bonjour@agorabica.fr>"

# --- Site ---
# URL publique du site (utilisée pour les liens dans les emails et l'OpenGraph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
